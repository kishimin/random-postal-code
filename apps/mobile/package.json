{
  "name": "@zipnami/mobile",
  "private": true,
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "run:android": "expo run:android",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && eslint .",
    "test": "vitest run && jest --ci",
    "test:small": "vitest run --coverage --passWithNoTests small.test",
    "test:medium": "vitest run --coverage --passWithNoTests medium.test && jest --ci --coverage",
    "test:screens": "jest --ci --coverage",
    "test:large": "vitest run --coverage --passWithNoTests large.test",
    "test:coverage:pr": "COVERAGE_THRESHOLD=80 vitest run --coverage --passWithNoTests src/"
  },
  "dependencies": {
    "@zipnami/shared": "workspace:*",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/runtime": "^7.29.2",
    "@jest/globals": "30.5.2",
    "@testing-library/react-native": "14.1.0",
    "@types/node": "^24.13.3",
    "@types/react": "~19.3.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "jest-expo": "~58.0.14",
    "oxlint": "^1.75.0",
    "test-renderer": "1.3.0",
    "typescript": "~6.0.3",
    "vitest": "4.1.10"
  }
}
