# Copy to apps/mobile/.env (ignored by Git) or set in the shell before
# `expo start` / `expo export`. Expo inlines EXPO_PUBLIC_* values into the
# bundle at build time, so put nothing secret here.

# Origin of the Zipnami API, e.g. the Worker's production URL.
EXPO_PUBLIC_API_BASE_URL=

# AdMob banner ad units (Issue #15), one per app. Leave them empty until
# AdMob is set up: development and automated runs always request Google's
# test banner, and only a release build uses a unit set here.
EXPO_PUBLIC_AD_BANNER_UNIT_ID_ANDROID=
EXPO_PUBLIC_AD_BANNER_UNIT_ID_IOS=
# Deprecated alias for EXPO_PUBLIC_AD_BANNER_UNIT_ID_ANDROID, from before the
# units were split per platform. It never applies to iOS.
EXPO_PUBLIC_AD_BANNER_UNIT_ID=

# AdMob app IDs (Issue #15). Unlike the variables above they are not inlined
# into the bundle: app.config.ts writes them into AndroidManifest.xml and
# Info.plist when the native project is generated, so they must be set where
# that happens (the EAS `production` profile's env, or the shell for a local
# `expo prebuild`). Empty means Google's test app IDs. Put nothing in a
# non-production profile of eas.json.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
