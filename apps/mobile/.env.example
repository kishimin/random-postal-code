# Copy to apps/mobile/.env (ignored by Git) or set in the shell before
# `expo start` / `expo export`. Expo inlines EXPO_PUBLIC_* values into the
# bundle at build time, so put nothing secret here.

# Origin of the Zipnami API, e.g. the Worker's production URL.
EXPO_PUBLIC_API_BASE_URL=

# AdMob banner ad unit ID (Issue #15). Leave empty until AdMob is set up.
EXPO_PUBLIC_AD_BANNER_UNIT_ID=
