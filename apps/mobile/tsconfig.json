{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    /* @zipnami/shared is compiled from source and imports with .ts. */
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "app.config.ts", "vitest.config.ts", "expo-env.d.ts"]
}
