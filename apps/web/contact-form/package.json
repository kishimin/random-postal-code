{
  "name": "@zipnami/web-contact-form",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint && eslint .",
    "test": "vitest run",
    "test:small": "vitest run --coverage --passWithNoTests small.test",
    "test:medium": "vitest run --coverage --passWithNoTests medium.test",
    "test:large": "vitest run --coverage --passWithNoTests large.test",
    "test:coverage:pr": "COVERAGE_THRESHOLD=80 vitest run --coverage --passWithNoTests src/"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vitest": "4.1.10"
  }
}
