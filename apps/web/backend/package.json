{
  "name": "@zipnami/web-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint && eslint .",
    "test": "vitest run",
    "test:small": "vitest run --coverage --passWithNoTests small.test",
    "test:medium": "vitest run --coverage --passWithNoTests medium.test",
    "test:large": "vitest run --coverage --passWithNoTests large.test",
    "test:coverage:pr": "COVERAGE_THRESHOLD=80 vitest run --coverage --passWithNoTests small.test medium.test",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "@zipnami/shared": "workspace:*",
    "hono": "^4.12.23",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260906.1",
    "@vitest/coverage-istanbul": "4.1.10",
    "eslint": "9.39.5",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vitest": "4.1.10",
    "wrangler": "^4.129.0"
  }
}
