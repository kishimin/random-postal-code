# Base URL of the Zipnami public API, read at build time.
# Local development points at the Hono backend running in the Workers runtime.
VITE_API_BASE_URL="http://localhost:8787"

# Web Maps API key (design.md section 7), read at build time. Optional: Maps
# is isolated from core Web behavior, so an empty value builds a working app
# whose map region falls back instead of embedding a map. Getting and
# restricting a real key is out of scope for Issue #8; use a placeholder here
# until that work assigns one.
VITE_GOOGLE_MAPS_API_KEY=""
