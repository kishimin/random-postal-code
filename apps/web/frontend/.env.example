# Base URL of the Zipnami public API, read at build time.
# Local development points at the Hono backend running in the Workers runtime.
VITE_API_BASE_URL="http://localhost:8787"

# Optional. Google AdSense publisher client ID ("ca-pub-..."). AdSense is an
# optional dependency (design.md section 7): leaving this unset still produces
# a working build, using a safe placeholder client ID instead.
VITE_GOOGLE_ADSENSE_CLIENT_ID="ca-pub-0000000000000000"

# Optional. The reserved advertisement region's AdSense ad slot ID. Same
# optional-dependency contract as the client ID above: leaving this unset
# still produces a working build, using a safe placeholder slot ID instead.
VITE_GOOGLE_ADSENSE_SLOT_ID="0000000000"

# Optional. Set to the exact string "false" to request live ads instead of
# AdSense's test ads. Any other value, including leaving this unset, keeps
# test ads (fails safe) -- "true" here is illustrative, not the one value
# that turns test mode off.
VITE_ADSENSE_TEST_MODE="true"
