{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc",
    "unicorn",
    "import",
    "jsx-a11y",
    "jsdoc",
    "vitest"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "ignorePatterns": [
    "src/components/ui/*.tsx",
    "!src/components/ui/*.stories.tsx",
    ".stryker-tmp/**",
    "reports/**"
  ]
}
