{
  "name": "@zipnami/web-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint && eslint .",
    "lint:markup": "markuplint \"src/**/*.tsx\"",
    "preview": "vite preview",
    "test": "vitest run --project=unit",
    "test:small": "vitest run --project=unit --coverage --passWithNoTests small.test",
    "test:medium": "vitest run --project=unit --coverage --passWithNoTests medium.test",
    "test:large": "vitest run --project=unit --coverage --passWithNoTests large.test",
    "test:storybook": "vitest run --project=storybook --coverage --passWithNoTests",
    "test:coverage:pr": "COVERAGE_THRESHOLD=80 vitest run --project=unit --coverage --passWithNoTests small.test medium.test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "e2e": "playwright test",
    "mutation-test": "stryker run"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.31",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.32.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "9.39.5",
    "@faker-js/faker": "^10.6.0",
    "@markuplint/jsx-parser": "^4.18.3",
    "@markuplint/react-spec": "^4.18.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-mcp": "latest",
    "@storybook/addon-vitest": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.1.3",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^64.2.0",
    "eslint-plugin-oxlint": "^1.78.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^10.5.8",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "markuplint": "^4.18.3",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "oxlint": "^1.75.0",
    "playwright": "latest",
    "shadcn": "^4.19.0",
    "storybook": "^10.5.8",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "7.3.1",
    "vitest": "4.1.10"
  },
  "trustedDependencies": [
    "esbuild",
    "msw",
    "unrs-resolver"
  ],
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
